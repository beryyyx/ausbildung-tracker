# Скопируй в .env. Путь к файлу базы данных SQLite относительно корня проекта.
DB_FILE_NAME=data/app.db
# Папка для загруженных PDF (свидетельства в профиле) относительно корня проекта.
UPLOADS_DIR=uploads
# OAuth-приложение Google для модуля Gmail (Google Cloud Console → Credentials).
# Redirect URI должен совпадать с зарегистрированным: http://localhost:3000/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
